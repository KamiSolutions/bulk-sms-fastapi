# BulkSMS API token: BulkSMS web app > Settings > API Tokens. Never commit the real .env.
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
# US/Canada need a sending number you own on BulkSMS (toll-free or 10DLC), in E.164.
BULKSMS_FROM=+18885550100
# ECONOMY | STANDARD | PREMIUM
BULKSMS_ROUTING_GROUP=STANDARD
# Key clients must send in the X-API-Key header to use the FastAPI service.
APP_API_KEY=change-me
